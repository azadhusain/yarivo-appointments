# ============================================================
# Appointment Booking SaaS - Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# --- App ---
ENVIRONMENT=development
APP_NAME=Appointment Booking API
APP_VERSION=0.1.0
DEBUG=true

# --- Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_REFRESH_SECRET=change-me-another-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
# Local docker-compose default
DATABASE_URL=postgresql+asyncpg://app:app_password@localhost:5432/appointment_saas

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# --- Public booking ---
PUBLIC_BASE_URL=http://localhost:3000

# --- Email (Resend default - abstraction allows others) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Appointment Booking <no-reply@yourdomain.com>

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_FREE=
STRIPE_PRICE_BASIC=price_xxxx
STRIPE_PRICE_PRO=price_xxxx
